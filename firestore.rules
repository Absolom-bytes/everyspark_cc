rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Admin ---
    match /admins/{userId} {
      allow read: if isAdmin();
    }

    // --- Reports ---
    function isValidReport(data) {
      return data.targetId is string && data.targetId.size() > 0
          && data.targetType in ['post', 'comment', 'user']
          && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000
          && data.reporterId == request.auth.uid
          && data.status == 'pending'
          && data.createdAt == request.time;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidReport(incoming()) && isValidId(reportId);
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // --- User Profiles ---
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50
          && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
          && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Basic list for authors
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().createdAt == existing().createdAt
                     && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio']);
    }

    // --- Posts ---
    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
          && data.authorId == request.auth.uid
          && data.createdAt == request.time;
    }

    match /posts/{postId} {
      allow read: if true; // Public forum
      allow create: if isSignedIn() && isValidPost(incoming()) && isValidId(postId);
      allow update: if isSignedIn() && (
        // Author can edit content
        (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content']) && isValidPost(incoming())) ||
        // Anyone can increment comment count (simplified for this demo, ideally use a function)
        (incoming().diff(existing()).affectedKeys().hasOnly(['commentCount']))
      );
      allow delete: if isOwner(existing().authorId) || isAdmin();
      
      // Comments Subcollection
      match /comments/{commentId} {
        function isValidComment(data) {
          return data.content is string && data.content.size() > 0 && data.content.size() <= 2000
              && data.authorId == request.auth.uid
              && data.postId == postId
              && data.createdAt == request.time;
        }

        allow read: if true;
        allow create: if isSignedIn() && isValidComment(incoming()) && isValidId(commentId);
        allow update: if isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['content']) && isValidComment(incoming());
        allow delete: if isOwner(existing().authorId) || isAdmin();
      }
    }
  }
}
